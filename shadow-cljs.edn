{:nrepl {:port 8777}

 :deps {:aliases [:dev]}

 :dev-http
 {4200 "public"}

 :builds
 {:app {:target :browser

        :output-dir "public/js"
        :asset-path "/js"
        :module-loader true
        :modules
        {:main {:init-fn amp.core/init!}

         :landing-view {:entries [amp.views.landing-view]
                        :depends-on #{:main}}

         :video-background {:entries [amp.components.elements.video-background]
                            :depends-on #{:main}}

         :budget-view {:entries [amp.views.budget-view]
                       :depends-on #{:main}}}
        :build-hooks [(git-hash/hook)]
        :devtools {:reload-strategy :full
                   :repl-pprint true
                   :preloads [amp.dev user]}
        :dev {:js-options {:output-feature-set :es-unsupported
                           :language-in :unsupported}
              :compiler-options {:output-feature-set :es8
                                 :closure-defines {amp.config/git-hash "https://sfsmp6cu.api.sanity.io/v2021-10-21/data/query/production?query="}}}}

  :release {:target :browser
            :output-dir "release/js"
            :asset-path "/js"
            :module-loader true
            :modules
            {:main {:init-fn amp.core/init!}

             :landing-view {:entries [amp.views.landing-view]
                            :depends-on #{:main}}

             :video-background {:entries [amp.components.elements.video-background]
                                :depends-on #{:main}}

             :budget-view {:entries [amp.views.budget-view]
                           :depends-on #{:main}}}
            :build-hooks [(git-hash/hook)]
            :js-options {:output-feature-set :es-unsupported
                         :language-in :unsupported}
            :compiler-options {:output-feature-set :es8

                               :optimizations :advanced
                               :pretty-print false
                               :closure-defines {amp.config/sanity-endpoint "https://sfsmp6cu.api.sanity.io/v2021-10-21/data/query/production?query="}}}}}
