(defn localize [{:keys [slug] :as f}]
  (let [k #(t (keyword "films" (str slug "." %)))]
    (assoc f :title (k "title") :when (k "when") :where (k "where") :summary (k "summary"))))

(defn films
  "Every film, newest first, in the current locale. Call it while rendering."
  []
  (mapv localize entries))

(defn running-time
  "Seconds → \"2:57\"."
  [s]
  (let [m (quot s 60) r (mod s 60)]
    (str m ":" (when (< r 10) "0") r)))
