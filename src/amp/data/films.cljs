(ns amp.data.films
  "Studio films on Mux (public playback ids, 2160p, English captions
   generated by Mux). Newest first. :poster is the still time in seconds.
   Source edits live in Dropbox: Else Run/projects/the_studio/media/video.
   Titles (kept in English: they are titles of works), dates, places and
   summaries are in the films catalog (resources/i18n/<locale>/films.json,
   keys <slug>.title, .when, .where, .summary)."
  (:require [amp.i18n :refer [t] :refer-macros [defcatalog]]))

(defcatalog "films")

