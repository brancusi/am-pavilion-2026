(ns amp.data.press-images
  "The press images as last built, generated by build/press-kit.mjs from
   resources/data/press/press.json. Don't edit by hand: npm run press:kit.
   The press page lays out from this, then takes the live list. groups: the
   Press kit selection's groups in order (each image's :group is one's :id).")

(def groups
 [{:id "press-g10"
   :name "Walking the Work · 18 November, the Accademia and San Marco"
   :note "Twelve works by boat to the Accademia di Belle Arti, carried into its cloister, then across the Bacino to Piazza San Marco. Photographs by Mina Biasutti."}
  {:id "press-g01"
   :name "Walking the Work · 14 November, San Marco"
   :note "The fourth walk: twelve works from Tesa 41 along the Riva degli Schiavoni to Piazza San Marco and home. Photographs by Mina Biasutti."}
  {:id "press-g02"
   :name "Walking the Work · 6 November, the Arsenale"
   :note "The second walk: six works over the bridge at the Arsenale gate to the Museo Storico Navale and the lagoon. Photographs by Mina Biasutti."}
  {:id "press-g03"
   :name "The Italian flag"
   :note "The tricolore carried through Venice: its drawings and renderings, and the flag made, assembled and carried in the studio."}
  {:id "press-g04"
   :name "The Armenian flag"
   :note "Armenian Flag Stack: the drawing and the renderings, in the pavilion and in Yerevan."}
  {:id "press-g05"
   :name "The Studio, Venice 2026"
   :note "The works in Tesa 41: installation views of the pavilion."}
  {:id "press-g06"
   :name "Making the works"
   :note "Casting, pigmenting and assembling in the studio; the colour palettes."}
  {:id "press-g07"
   :name "Studies and renderings"
   :note "Drawings and renderings of the works made or planned for The Studio."}
  {:id "press-g08"
   :name "People"
   :note "Zadik Zadikian, Aram Zadikian, the curators and guests."}
  {:id "press-g09"
   :name "The archive, 1974–1980"
   :note "The gold spaces and gold works, Yellow Space and Red Space, One Thousand Gold Bricks."}])

