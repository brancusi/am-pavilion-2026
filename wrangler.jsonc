// Armenian Pavilion 2026 site — static assets on Cloudflare Workers.
// `npm run release` builds into ./release, then `npx wrangler deploy` ships it.
// armenianpavilion2026.org and www.* are redirected here by cloudflare/redirect.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "am-pavilion",
  // Az@atd.dev's Account — owns the armenianpavilion.org and armenianpavilion2026.org zones
  "account_id": "badb2c07d9cd1effc4c60bc8b6e55826",
  "compatibility_date": "2026-10-01",
  // Link previews for journal posts and press films and images, the press ZIPs and the
  // newsletter sign-up (/api/subscribe, secret BUTTONDOWN_API_KEY); see cloudflare/site/worker.js
  "main": "cloudflare/site/worker.js",
  "assets": {
    "directory": "./release",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/blog", "/blog/*", "/films/*", "/walks", "/walks/*", "/visit", "/visit/*", "/artist", "/artist/*", "/portage", "/portage/*", "/armenian-as-well", "/armenian-as-well/*", "/route-from-hotel-gabrielli", "/route-from-hotel-gabrielli/*", "/delivery", "/delivery/*", "/press", "/press/*", "/it/press", "/it/press/*"],
    // Client-side routes (/visit, /blog/:slug, …) fall back to index.html
    "not_found_handling": "single-page-application"
  },
  // The press images, read (never written) by the ZIPs on /press/zip/*
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "armenia-pavilion-media" }],
  "workers_dev": true,
  // A route (not a custom domain) because the zone's existing proxied record
  // stays in place; the Worker answers every request before it reaches it.
  "routes": [
    { "pattern": "armenianpavilion.org/*", "zone_name": "armenianpavilion.org" }
  ]
}
